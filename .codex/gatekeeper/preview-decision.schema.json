{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "summary",
    "authorityIds",
    "authoritySetDigest",
    "valid"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "BLOCK",
        "OWNER_DECISION"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "ownerDecisionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "authorityIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "synthetic-architecture",
          "fixture-boundary"
        ]
      }
    },
    "authoritySetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "valid": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "OWNER_DECISION"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "ownerDecisionId"
        ]
      }
    }
  ]
}
