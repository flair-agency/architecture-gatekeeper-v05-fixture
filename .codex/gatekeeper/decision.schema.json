{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "ownerDecisionId", "authorityIds"],
  "properties": {
    "decision": { "type": "string", "enum": ["PASS", "BLOCK", "OWNER_DECISION"] },
    "summary": { "type": "string" },
    "ownerDecisionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "authorityIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
