{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "summary",
    "authorityFiles",
    "valid"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "BLOCK",
        "OWNER_DECISION"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "ownerDecisionId": {
      "type": "string",
      "enum": [
        "fixture-release-notes-owner"
      ]
    },
    "authorityFiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "docs/architecture.md",
          "docs/fixture-boundary.md"
        ]
      }
    },
    "authorityIds": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "synthetic-architecture",
          "fixture-boundary"
        ]
      }
    },
    "valid": {
      "type": "boolean"
    }
  },
  "anyOf": [
    {
      "properties": {
        "decision": {
          "enum": [
            "PASS",
            "BLOCK"
          ]
        }
      }
    },
    {
      "properties": {
        "decision": {
          "enum": [
            "OWNER_DECISION"
          ]
        }
      },
      "required": [
        "ownerDecisionId"
      ]
    }
  ]
}
